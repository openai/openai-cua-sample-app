# Runner settings. Copy this file to javascript-app/.env and set your API key.
# The API key must have access to CUA_DEFAULT_MODEL.
# The provided dev, start, and test:live scripts load that file.
OPENAI_API_KEY=""
HOST="127.0.0.1"
PORT="4001"
CUA_DEFAULT_MODEL="gpt-5.6-sol"
CUA_RESPONSES_MODE="auto"

# Optional additional browser origins, separated by commas:
# CUA_ALLOWED_ORIGINS="https://your-console.example"

# Web overrides belong in apps/demo-web/.env.local or the web process's shell.
# Next.js does not load this file. The console uses CUA_DEFAULT_MODEL from the
# runner unless NEXT_PUBLIC_CUA_DEFAULT_MODEL is explicitly set for the web app.
# RUNNER_BASE_URL="http://127.0.0.1:4001"
# NEXT_PUBLIC_CUA_DEFAULT_MODEL="gpt-5.6-sol"
# NEXT_PUBLIC_CUA_DEFAULT_MAX_RESPONSE_TURNS="24"
