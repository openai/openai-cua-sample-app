# Copy to .env and set OPENAI_API_KEY.
OPENAI_API_KEY=""
HOST="127.0.0.1"
PORT="4041"
CUA_DEFAULT_MODEL="gpt-5.6"
# auto: use an available API key; live: require one; fallback: no API calls.
CUA_RESPONSES_MODE="auto"
