{
  "name": "openai-cua-sample-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "node scripts/launch.mjs",
    "dev:js": "node scripts/launch.mjs javascript",
    "dev:python": "node scripts/launch.mjs python",
    "start:js": "node scripts/launch.mjs javascript --production",
    "start:python": "node scripts/launch.mjs python --production",
    "lint": "eslint console javascript-app contracts scripts --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter !cua-sample-labs test && node --test scripts/*.test.mjs",
    "build": "pnpm -r --if-present build",
    "check:js": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:python": "uv run --project python-app ruff check python-app && uv run --project python-app mypy --config-file python-app/pyproject.toml python-app/app && uv run --project python-app pytest python-app/tests",
    "check:labs": "pnpm --filter cua-sample-labs check",
    "check": "pnpm check:js && pnpm check:python && pnpm check:labs",
    "playwright:install": "pnpm --filter @cua-sample/runner playwright:install",
    "playwright:install:with-deps": "pnpm --filter @cua-sample/runner playwright:install:with-deps",
    "python:install": "uv sync --project python-app --frozen",
    "python:playwright:install": "uv run --project python-app playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@next/eslint-plugin-next": "15.5.24",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.29.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@>=0.16 <0.16.8": "^0.16.8",
      "brace-expansion@>=1 <1.1.18": "^1.1.18",
      "brace-expansion@>=5 <5.0.9": "^5.0.9",
      "fast-uri@>=3 <3.1.6": "^3.1.6",
      "flatted@>=3 <3.4.2": "^3.4.2",
      "js-yaml@>=4 <4.3.1": "^4.3.1",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "next>sharp": "^0.35.4",
      "picomatch@>=2 <2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.7",
      "postcss@>=8 <8.5.23": "^8.5.26",
      "ws@>=8 <8.21.0": "^8.21.3"
    }
  }
}
